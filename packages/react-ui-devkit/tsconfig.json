{
  "compilerOptions": {
    "baseUrl": "./",
    "jsx": "react",
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "removeComments": false,
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": false,
    "lib": ["es2022", "es2020.intl", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "skipLibCheck": true, // TODO: @kamil temponary hack we can't resolve good dependecies.
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "transform": "typescript-transform-paths"
      },
      {
        "transform": "typescript-transform-paths",
        "afterDeclarations": true
      }
    ]
  },
  "exclude": ["dist", "node_modules", "docs", "generate-docs.ts", "**/*.spec.ts"]
}
