{
  "compilerOptions": {
    "baseUrl": "./",
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "removeComments": false,
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "declaration": false,
    "sourceMap": false,
    "strictPropertyInitialization": false,
    "lib": ["es2022", "es2020.intl", "dom", "dom.iterable"],
    "skipLibCheck": true, // TODO: @kamil temponary hack we can't resolve good dependecies.
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "transform": "typescript-transform-paths"
      },
      {
        "transform": "typescript-transform-paths",
        "afterDeclarations": true
      }
    ]
  },
  "exclude": ["node_modules", "dist"]
}
