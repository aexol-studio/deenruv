{
  "name": "@deenruv/product-badges-plugin",
  "version": "1.0.17-dev.27",
  "homepage": "https://deenruv.com/",
  "license": "MIT",
  "files": [
    "dist/**/*"
  ],
  "main": "./dist/plugin-server/index.js",
  "exports": {
    ".": "./dist/plugin-server/index.js",
    "./plugin-server": "./dist/plugin-server/index.js",
    "./plugin-ui": "./dist/plugin-ui/index.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build",
    "watch": "tsc --build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "zeus": "zeus http://localhost:6100/admin-api ./src/plugin-server --td && zeus http://localhost:6100/admin-api ./src/plugin-ui --td && prettier --write ./src/plugin-server/zeus/*.ts ./src/plugin-ui/zeus/*.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "@deenruv/common": "workspace:^",
    "@deenruv/react-ui-devkit": "workspace:^",
    "@deenruv/admin-types": "workspace:^",
    "react-i18next": "^14.0.5",
    "react-router": "^7.13.0",
    "graphql-zeus": "^7.0.0",
    "lucide-react": "^1.21.0",
    "sonner": "^1.4.41",
    "@nestjs/common": "^10.3.10",
    "@nestjs/graphql": "^12.2.0",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@deenruv/core": "workspace:^",
    "typescript": "5.3.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^5.0.10"
  },
  "peerDependencies": {
    "@deenruv/core": "^1.0.0 || ^1.0.17-dev.0",
    "typeorm": "^0.3.20"
  }
}
